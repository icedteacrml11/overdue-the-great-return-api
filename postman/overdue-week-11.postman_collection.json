    {
      "name": "2. Sessions and Players",
      "item": [
        {
          "name": "14. A host starts a game - POST /sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 and LOBBY with 6-digit code', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('LOBBY');",
                  "  pm.expect(body.code).to.match(/^[1-9][0-9]{5}$/);",
                  "  pm.collectionVariables.set(\"code\", pm.response.json().code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{hostToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_set_id\": 1\n}"
            },
            "url": "{{baseUrl}}/sessions"
          }
        },
