      "name": "0. Accounts and Auth",
      "item": [
        {
          "name": "0a. Register new account - POST /auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 and role is PLAYER without password_hash', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.role).to.eql('PLAYER');",
                  "  pm.expect(body.user.password_hash).to.be.undefined;",
                  "  pm.collectionVariables.set('newUserId', body.user.user_id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_id\": \"2099-3001\",\n  \"full_name\": \"Nina Cruz\",\n  \"email\": \"nina@overdue.test\",\n  \"password\": \"Aklat-Demo-2026\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
