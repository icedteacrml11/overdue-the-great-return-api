      "request": {
        "method": "DELETE",
        "header": [
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "url": "{{baseUrl}}/question-sets/{{setId}}"
      }
    },
    {
      "name": "14. Start game - POST /sessions as host",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201 and LOBBY with 6-digit code', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('LOBBY');",
              "  pm.expect(body.code).to.match(/^[1-9][0-9]{5}$/);",
              "  pm.collectionVariables.set('code', body.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question_set_id\": 1\n}"
        },
        "url": "{{baseUrl}}/sessions"
      }
    },
    {
      "name": "15. Join game - POST /sessions/{{code}}/players as player 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201 and rejoined is false', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.rejoined).to.eql(false);",
              "  pm.collectionVariables.set('playerId', body.player_id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{player}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nickname\": \"BookRunner\"\n}"
        },
        "url": "{{baseUrl}}/sessions/{{code}}/players"
      }
    },
    {
      "name": "16. Rejoin game - POST /sessions/{{code}}/players again as player 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200, same player_id, rejoined is true', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.rejoined).to.eql(true);",
              "  pm.expect(body.player_id).to.eql(pm.collectionVariables.get('playerId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{player}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nickname\": \"BookRunner\"\n}"
        },
        "url": "{{baseUrl}}/sessions/{{code}}/players"
      }
    },
