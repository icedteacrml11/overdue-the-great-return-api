    {
      "name": "13. Delete - DELETE /{{setId}} as host",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
