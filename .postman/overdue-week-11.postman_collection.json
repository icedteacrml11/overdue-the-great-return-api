{
  "info": {
    "name": "Overdue: The Great Return API - Week 11",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
    { "key": "host", "value": "2099-0001" },
    { "key": "otherHost", "value": "2099-0099" },
    { "key": "player", "value": "2099-1001" },
    { "key": "player2", "value": "2099-1002" },
    { "key": "setId", "value": "" },
    { "key": "code", "value": "" },
    { "key": "playerId", "value": "" }
  ],
  "item": [
    {
      "name": "1. It works - POST valid body as host",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set('setId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Philippine Literature\"\n}"
        },
        "url": "{{baseUrl}}/question-sets"
      }
    },
    {
      "name": "2. A field is wrong - POST short title",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400 VALIDATION_FAILED', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"ab\"\n}"
        },
        "url": "{{baseUrl}}/question-sets"
      }
    },
    {
