{
  "name": "overdue-the-great-return-api",
  "version": "1.0.0",
  "description": "Multiplayer quiz race API for the Library Game Hub (CS 313 Software Engineering 1)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "node scripts/db-wipe.js && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:check": "node scripts/db-check.js",
    "start:render": "sequelize-cli db:migrate && node scripts/create-admin.js && node src/server.js",
    "docs:dictionary": "node scripts/make-data-dictionary.js",
    "docs:api": "node scripts/make-api-reference.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "check": "node scripts/ci-check.js"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/setup/global-setup.js",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Carl Angelo Orlina",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
